{{!-- Application V2 Item Sheet Template - Close Combat Weapon --}}
<div>
  <header class="sheet-header flexrow">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="item-name">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'BNW.ItemType.CloseCombatWeapon'}}" />
      </h1>
      <div class="details-grid">
        <label>
          <span>{{localize "BNW.Label.AttackSkill"}}</span>
          <select name="system.attackSkill">
            <option value="">&mdash;</option>
            {{#each skillOptions as |skill|}}
              <option value="{{skill.name}}" {{#if (eq ../system.attackSkill skill.name)}}selected{{/if}}>{{skill.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>
          <span>{{localize "BNW.Label.DefensiveBonus"}}</span>
          <input type="number" name="system.defensiveBonus" value="{{system.defensiveBonus}}" placeholder="0" />
        </label>
        <label>
          <span>{{localize "BNW.Label.Quickness"}}</span>
          <input type="number" name="system.quickness" value="{{system.quickness}}" placeholder="0" />
        </label>
        <label>
          <span>{{localize "BNW.Label.DamageType"}}</span>
          <select name="system.damageType">
            <option value="strength" {{#if (eq system.damageType "strength")}}selected{{/if}}>{{localize "BNW.DamageType.Strength"}}</option>
            <option value="stun" {{#if (eq system.damageType "stun")}}selected{{/if}}>{{localize "BNW.DamageType.Stun"}}</option>
            <option value="none" {{#if (eq system.damageType "none")}}selected{{/if}}>{{localize "BNW.DamageType.None"}}</option>
          </select>
        </label>
        <label>
          <span>{{localize "BNW.Label.DamageModifier"}}</span>
          <input type="number" name="system.damageModifier" value="{{system.damageModifier}}" placeholder="0" />
        </label>
        <label>
          <span>{{localize "BNW.Label.CostDollars"}}</span>
          <input type="number" name="system.cost" value="{{system.cost}}" placeholder="0" step="1" min="0" />
        </label>
      </div>
    </div>
  </header>

  <section class="sheet-body">
    <div class="form-group stacked">
      <label>{{localize "BNW.Label.Description"}}</label>
      <textarea name="system.description" placeholder="{{localize 'BNW.Placeholder.Description'}}">{{system.description}}</textarea>
    </div>
  </section>
</div>

<div class="quirks-section">
  <div class="item-controls header">
    <button type="button" data-action="createItem" data-type="quirk">
      <i class="fas fa-plus"></i> {{localize 'BNW.Action.AddQuirk'}}
    </button>
    <div class="negative-quirks-total">
      <strong>{{localize 'BNW.Label.TotalNegativeQuirks'}}:</strong> {{negativeQuirksTotal}} / 10
    </div>
  </div>
  <ol class="quirks-list">
    {{#each quirks as |item|}}
      <li class="item quirk flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <h4>{{item.name}}</h4>
          {{#if item.system.cost}}
            <p class="cost">
              <strong>{{localize 'BNW.Label.Cost'}}:</strong>
              {{#if (eq item.system.cost 0)}}
                0
              {{else if (gt item.system.cost 0)}}
                +{{item.system.cost}}
              {{else}}
                {{item.system.cost}}
              {{/if}}
            </p>
          {{/if}}
          {{#if item.system.quirkType}}
            <p class="quirk-type"><em>{{localize 'BNW.Label.QuirkType'}}: {{item.system.quirkType}}</em></p>
          {{/if}}
          {{#if item.system.requirements}}
            <p class="requirements"><em>{{localize 'BNW.Label.Requirements'}}: {{item.system.requirements}}</em></p>
          {{/if}}
        </div>
        <div class="item-controls">
          <a data-action="editItem" data-item-id="{{item.id}}" title="{{localize 'BNW.Action.Edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" data-item-id="{{item.id}}" title="{{localize 'BNW.Action.Delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
</div>

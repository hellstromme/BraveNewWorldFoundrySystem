<div class="tricks-section">
  <div class="item-controls header">
    <button type="button" data-action="createItem" data-type="trick">
      <i class="fas fa-plus"></i> {{localize 'BNW.Action.AddTrick'}}
    </button>
  </div>
  <ol class="tricks-list">
    {{#each tricks as |item|}}
      <li class="item trick flexrow" data-item-id="{{item.id}}">
        <div class="item-name">
          <h4>{{item.name}}</h4>
          <p class="summary">{{item.system.summary}}</p>
          {{#if item.system.requiresPower}}
            <p class="requirement"><em>{{localize 'BNW.Label.RequiresPower'}}: {{item.system.requiredPowerName}}</em></p>
          {{/if}}
        </div>
        <div class="item-controls">
          <a data-action="editItem" data-item-id="{{item.id}}" title="{{localize 'BNW.Action.Edit'}}">
            <i class="fas fa-edit"></i>
          </a>
          <a data-action="deleteItem" data-item-id="{{item.id}}" title="{{localize 'BNW.Action.Delete'}}">
            <i class="fas fa-trash"></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
</div>

<div class="bnw-roll-card">
  <header>
    <h2>{{title}}</h2>
    <p class="subtitle">
      {{actorName}} &mdash; 
      {{traitLabel}} ({{traitDice}}d6)
      {{#if skillLabel}}
        + {{skillLabel}} (+{{skillBonus}})
      {{/if}}
      {{#if bonusDice}}
        + {{bonusDice}} bonus dice
      {{/if}}
    </p>
  </header>
  <section class="dice-results">
    <div class="dice-list">
      {{#each dice as |die|}}
        <span class="die">{{die}}</span>
      {{/each}}
    </div>
    <div class="result-summary">
      <div>
        <span class="label">{{localize 'BNW.Label.Highest'}}</span>
        <span class="value">{{highest}}</span>
      </div>
      {{#if totalBonus}}
        <div>
          <span class="label">{{localize 'BNW.Label.Bonus'}}</span>
          <span class="value">+{{totalBonus}}</span>
        </div>
      {{/if}}
      <div>
        <span class="label">{{localize 'BNW.Label.Final'}}</span>
        <span class="value">{{finalResult}}</span>
      </div>
      <div>
        <span class="label">{{localize 'BNW.Label.Target'}}</span>
        <span class="value">{{target}}</span>
      </div>
      <div class="outcome {{#if success}}success{{else}}failure{{/if}}">
        {{#if success}}
          {{localize 'BNW.Roll.Success'}}
        {{else}}
          {{localize 'BNW.Roll.Failure'}}
        {{/if}}
      </div>
    </div>
  </section>
</div>

